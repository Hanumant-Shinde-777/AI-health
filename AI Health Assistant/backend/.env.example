# PORT=5000
# # Encode special chars in password: # → %23, @ → %40. Keep the whole URL in double quotes.
# # Copy exact host from Supabase (may be aws-0 or aws-1). Encode # as %23, @ as %40.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD-ENCODED]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD-ENCODED]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRES_IN=7d
# CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=your_twilio_number
# TWILIO_MESSAGING_SERVICE_SID=  (optional, instead of TWILIO_PHONE_NUMBER)
# Without Twilio, production cannot send OTP codes (development prints them to the console)
# FRONTEND_URL=http://localhost:5173
# NODE_ENV=development
# OTP_TTL_MINUTES=10
# DEV_LOG_OTP=true  (defaults to true outside production, false in production)
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile
# JWT_SECRET is required in production (the default is insecure)
# Brute-force lockout for login OTP / password
# MAX_OTP_ATTEMPTS=5
# OTP_LOCK_MINUTES=15
# MAX_PASSWORD_ATTEMPTS=5
# PASSWORD_LOCK_MINUTES=15
# Per-IP rate limits
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_AUTH_WINDOW_MINUTES=15
# RATE_LIMIT_AI_MAX=40
# RATE_LIMIT_AI_WINDOW_MINUTES=1
# Set behind a reverse proxy (Render, Nginx, etc.) so rate limits see the real client IP
# TRUST_PROXY=1
