# =============================================================================
# AI Health Assistant — Docker environment
# Copy to `.env` in the repo root (next to docker-compose.yml) and fill in values:
#   cp .env.example .env
# `.env` is gitignored — never commit it.
# =============================================================================

NODE_ENV=production

# ---- Database (Supabase PostgreSQL) — REQUIRED -------------------------------
# Supabase → Project Settings → Database → Connection string.
# URL-encode special characters in the password: # → %23, @ → %40.
# Keep the quotes off: docker compose reads values literally.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Auth — REQUIRED in production ------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI (Groq) ---------------------------------------------------------------
# Free key at https://console.groq.com/keys. Without it AI follow-up questions fail.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- CORS / proxy ------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Must include the URL users open the app at, e.g. https://health.example.com
FRONTEND_URL=http://localhost
# Trust one proxy hop (nginx) so rate limits see the real client IP
TRUST_PROXY=1

# ---- OTP ---------------------------------------------------------------------
OTP_TTL_MINUTES=10
# SMS delivery via Twilio — REQUIRED in production, or nobody can receive a code and sign in
# (the API answers 503 "cannot send codes"). Set the sender as a number or a messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Without Twilio (local testing), set this to true to print OTP codes in `docker compose logs backend`.
# Leave false in real production (codes would end up in logs).
DEV_LOG_OTP=false

# ---- Uploads (Cloudinary) — optional, needed for profile pictures ------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Brute-force lockout -----------------------------------------------------
MAX_OTP_ATTEMPTS=5
OTP_LOCK_MINUTES=15
MAX_PASSWORD_ATTEMPTS=5
PASSWORD_LOCK_MINUTES=15

# ---- Per-IP rate limits ------------------------------------------------------
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_AI_MAX=40
RATE_LIMIT_AI_WINDOW_MINUTES=1

# ---- Support inbox -----------------------------------------------------------
# Comma-separated emails of existing patient/doctor accounts that may read Help & support
# messages. They see a "Support inbox" card on their profile page (/staff/support).
SUPPORT_STAFF_EMAILS=

# ---- Frontend build (baked into the bundle at `docker compose build`) --------
# "/api" = same origin; nginx proxies it to the backend container.
# Rebuild the frontend image after changing these.
VITE_API_URL=/api
# true = fall back to demo data when the API is unreachable (keep false in production)
VITE_DEMO_MODE=false

# ---- Redis (optional: docker compose --profile redis up -d) ------------------
# Reserved for a shared rate-limit store; the backend currently limits in memory.
REDIS_URL=redis://redis:6379

# ---- Published host ports ----------------------------------------------------
# The API always listens on PORT=5000 inside its container (set by docker-compose.yml);
# change BACKEND_PORT below to move the host-side port instead.
FRONTEND_PORT=80
BACKEND_PORT=5000
# docker-compose.dev.yml
DEV_FRONTEND_PORT=5173
DEV_BACKEND_PORT=5001
